DATABASE_URL=postgresql://postgres:password@localhost:5432/signacore
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── JSON -> relational migration (2026-08-20) ────────────────────────────
# Master switch for relational authority — see backend/src/relational/cutover.ts.
# MUST be "true" (exact string) to enable ANYTHING relational-authoritative,
# and even then only for sections whose relational_cutover.enabled DB row is
# also true. Leave unset/false in every environment until you have completed
# the full cutover checklist in the migration handoff document.
RELATIONAL_AUTHORITY_ENABLED=false

# Only needed to run backend/src/relational/backfill.ts --apply against a
# non-local database (never do this against production from this migration).
# ALLOW_UNSAFE_RELATIONAL_BACKFILL=1

# ── Integration API (/api/v1/integration) — 2026-10-07 ───────────────────
# Server-to-server API for integration clients (first client: Sally).
# OFF unless exactly "true". Clients are provisioned with the CLI; Sally
# belongs to Signacore company code 2:
#   node dist/integration/clientCli.js create --client-id sally --name "Sally AI Sales Assistant" --company-code 2
# which prints the client's secret ONCE (only a hash is stored).
INTEGRATION_API_ENABLED=false
# Requests per minute per integration client (default 120).
# INTEGRATION_RATE_LIMIT_PER_MIN=120
