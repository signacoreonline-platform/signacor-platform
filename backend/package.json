    "restore:pre-duplication-state": "node dist/db/restorePlatformStateBeforeDuplicationAugust2026.js",
    "export:live-state-readonly": "node dist/db/exportLivePlatformStateForComparisonAugust2026.js",
    "reconstruct:platform-state-after-duplication": "node dist/db/reconstructPlatformStateAfterDuplicationAugust2026.js"
